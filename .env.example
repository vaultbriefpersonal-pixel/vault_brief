# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth (NextAuth.js v5)
AUTH_SECRET=your-auth-secret-at-least-32-chars
AUTH_URL=http://localhost:3000

# Google OAuth
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=reports@vaultbrief.io

# On-chain data (Dune Sim API)
DUNE_API_KEY=your_dune_api_key

# On-chain data (Alchemy — EVM RPC + Asset Transfers API)
ALCHEMY_API_KEY=your_alchemy_api_key

# On-chain data (Helius — Solana RPC + Enhanced Transactions). Required only
# if any project has a Solana wallet; sync throws a clear error if missing.
HELIUS_API_KEY=your_helius_api_key

# Resend webhook signing secret (Svix). Used by /api/webhooks/resend to
# validate inbound email.opened / bounced events.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# Upstash Redis (rate limiting on login + critical mutations). If unset, the
# limiters fail open with a warning — endpoints stay up but unprotected.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Vercel Blob (pre-generated PDF storage). Auto-injected by Vercel when you
# create a Blob store; only needed locally if you want to test PDF flow.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# AI (Anthropic Claude)
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key

# Payments — DISABLED (public goods). VaultBrief is free; no paid plans.
# The Stripe/Atlos integration code is dormant and needs no env vars.
# To re-enable paid plans later, restore gating in plan-limits.ts and set
# STRIPE_* / ATLOS_* vars here.

# Sentry observability (optional). Without these, the SDK no-ops and the app
# runs identically — flip on by creating a Sentry project, copying the DSN
# into both vars (server + client) and redeploying.
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project-id

# GitHub PAT (fallback when a project hasn't supplied its own per-project
# token). Strongly recommended for any org with > 5 active repos — without
# auth the API caps at 60 req/hr per IP and snapshots will record zeros for
# commits/PRs/contributors. Read-only `public_repo` scope is enough.
GITHUB_TOKEN=ghp_your_personal_access_token

# Background Jobs (Trigger.dev)
TRIGGER_SECRET_KEY=tr_dev_your_trigger_secret_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
